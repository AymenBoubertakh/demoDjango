# Database Configuration
# These environment variables should be set in Render
DB_NAME=your_database_name
DB_USER=your_database_user
DB_PASSWORD=your_database_password
DB_HOST=your_database_hostname
DB_PORT=5432

# Example for Render PostgreSQL:
# DB_NAME=your_render_db_name
# DB_USER=your_render_db_user
# DB_PASSWORD=your_render_db_password
# DB_HOST=your_render_db_hostname.oregon-postgres.render.com
# DB_PORT=5432
